{
  "lesson": "04",
  "scenes": [
    {
      "key": "encoding",
      "title": {
        "zh": "把布局写成一串符号",
        "en": "Write a layout as symbols"
      },
      "say": {
        "zh": "我们用字母表示模块，用 H 和 V 表示两个区域如何组合。",
        "en": "Letters name blocks, while H and V describe how two regions combine."
      },
      "pack": {},
      "focus": [],
      "tokens": []
    },
    {
      "key": "push",
      "title": {
        "zh": "先压 A，再压 D",
        "en": "Push A, then D"
      },
      "say": {
        "zh": "先把 A 压入栈，再把 D 压入栈；D 就在栈顶。",
        "en": "Push A, then push D; D is now on top of the stack."
      },
      "pack": {
        "A": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "D": {
          "x": 4,
          "y": 0,
          "w": 3,
          "h": 1
        }
      },
      "focus": [
        "A",
        "D"
      ],
      "stack": [
        "A 3×2",
        "D 3×1"
      ]
    },
    {
      "key": "guess",
      "title": {
        "zh": "预测 A D H",
        "en": "Predict A D H"
      },
      "say": {
        "zh": "H 是水平切线，让第一个区域在下，第二个区域在上。",
        "en": "H names a horizontal cut, placing the first region below the second."
      },
      "pack": {},
      "focus": [],
      "question": {
        "text": {
          "zh": "A D H 组合后的宽×高？",
          "en": "Width × height after A D H?"
        },
        "options": [
          {
            "zh": "3×3",
            "en": "3×3"
          },
          {
            "zh": "6×2",
            "en": "6×2"
          }
        ],
        "answer": 0,
        "explain": {
          "zh": "宽取最大值 3，高为 2+1=3。",
          "en": "Maximum width is 3; heights add to 2+1=3."
        }
      }
    },
    {
      "key": "combine",
      "title": {
        "zh": "宽取最大，高度相加",
        "en": "Maximum width. Summed height."
      },
      "say": {
        "zh": "组合时先弹出 D，再弹出 A；D 放在 A 上面，得到三乘三。",
        "en": "Pop D first, then A; place D above A to obtain a three-by-three region."
      },
      "pack": {
        "A": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "D": {
          "x": 0,
          "y": 2,
          "w": 3,
          "h": 1
        }
      },
      "focus": [
        "A",
        "D"
      ],
      "stack": [
        "AD 3×3"
      ],
      "anchor": "place"
    },
