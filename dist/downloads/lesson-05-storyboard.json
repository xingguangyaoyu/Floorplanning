{
  "lesson": "05",
  "scenes": [
    {
      "key": "recipe",
      "title": {
        "zh": "一棵树，一份摆放配方",
        "en": "A tree is a packing recipe"
      },
      "say": {
        "zh": "树给出摆放关系，轮廓线决定每块模块最终落下的高度。",
        "en": "The tree describes placement relationships, while the skyline determines the height where each block lands."
      },
      "pack": {},
      "focus": [],
      "tree": "A(B(C(E,-),-),D)"
    },
    {
      "key": "root",
      "title": {
        "zh": "根模块落在原点",
        "en": "The root lands at the origin"
      },
      "say": {
        "zh": "先让根模块 A 落在原点，然后处理它的整个左子树。",
        "en": "First place root A at the origin, then process its entire left subtree."
      },
      "pack": {
        "A": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2
        }
      },
      "focus": [
        "A"
      ],
      "tree": "A(B(C(E,-),-),D)",
      "anchor": "root"
    },
    {
      "key": "walk",
      "title": {
        "zh": "A → B → C → E → D",
        "en": "A → B → C → E → D"
      },
      "say": {
        "zh": "左孩子从父模块的右边缘开始，B、C、E 依次落位，D 最后处理。",
        "en": "A left child starts at its parent’s right edge; B, C, and E land before D is processed."
      },
      "pack": {
        "A": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "B": {
          "x": 3,
          "y": 0,
          "w": 2,
          "h": 3
